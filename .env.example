DEBUG=True
SECRET_KEY=dev-only-change-me-in-prod

# --- Docker Compose (Postgres container) ---
POSTGRES_DB=drover
POSTGRES_USER=drover
POSTGRES_PASSWORD=drover

# --- Django app (local, connects to localhost:5432) ---
DATABASE_URL=postgresql://drover:drover@localhost:5432/drover

# API keys — empty is fine for local dev (DEBUG=True routes email to console)
SENDGRID_API_KEY=
FROM_NUMBER=+15555555555
TWILIO_SSID=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=

# Generate once and keep stable across deployments; never commit the private key.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:kathleen@droverapp.org